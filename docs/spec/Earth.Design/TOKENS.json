{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Earth.Design Tokens",
  "version": "1.1.0",
  "description": "Design system tokens for Next-Gen Crystal Glass DAW with Autumn Hues & Nature Greens palette",
  "color": {
    "background": {
      "obsidianDeep": { "value": "#0E0D0C", "type": "color" },
      "espressoGlass": { "value": "#141210", "opacity": 0.80, "type": "color" },
      "surfaceGlass": { "value": "#1A1815", "opacity": 0.75, "type": "color" },
      "surfaceRaised": { "value": "#23201C", "opacity": 0.85, "type": "color" }
    },
    "border": {
      "subtle": { "value": "#3D352B", "opacity": 0.20, "type": "color" },
      "highlight": { "value": "#FFFFFF", "opacity": 0.08, "type": "color" },
      "rimActive": { "value": "#FF7600", "opacity": 0.40, "type": "color" }
    },
    "autumnPalette": {
      "earthAmber": { "value": "#FF7600", "type": "color", "role": "Primary / Play / Active Clips" },
      "mapleAmber": { "value": "#FFA24D", "type": "color", "role": "Knob Halos / Peak Arc / Transients" },
      "autumnRust": { "value": "#D96B27", "type": "color", "role": "Snare / Claps / Transient Audio" },
      "terracotta": { "value": "#C85A32", "type": "color", "role": "Bass Synths / Distortion / Mute" },
      "chestnut": { "value": "#7B3F00", "type": "color", "role": "Sub Bass / Low-End Analog / Drums" },
      "harvestGold": { "value": "#D4AF37", "type": "color", "role": "Lead Synths / Master Bus / Solo" },
      "burntSienna": { "value": "#8B4513", "type": "color", "role": "Sub-groups / Aux Returns" },
      "crimsonMaple": { "value": "#9B2C2C", "type": "color", "role": "Record Arm / Clip Thresholds" }
    },
    "natureGreens": {
      "forestPine": { "value": "#1E3F20", "type": "color", "role": "Audio Recordings / Live Mic" },
      "emerald": { "value": "#2E7D4E", "type": "color", "role": "Acoustic Kits / Hi-Hats / In-Key Scale" },
      "mossSage": { "value": "#6B8E23", "type": "color", "role": "Pads / Reverb/Delay FX / Soundscapes" },
      "fern": { "value": "#4F7942", "type": "color", "role": "Granular Samplers / LFO Generators" },
      "sageLeaf": { "value": "#8FBC8F", "type": "color", "role": "Secondary Sends / Aux FX / Automation" },
      "oliveGrove": { "value": "#808000", "type": "color", "role": "Polyphonic Synths / Chords / FM" }
    },
    "metering": {
      "safeNatureGreen": { "value": "#38A169", "type": "color", "thresholdDb": -12 },
      "nominalAutumnAmber": { "value": "#D97706", "type": "color", "thresholdDb": -3 },
      "warningAutumnRust": { "value": "#DC2626", "type": "color", "thresholdDb": 0 },
      "clipRed": { "value": "#EF4444", "type": "color", "thresholdDb": 0.1 }
    }
  },
  "glass": {
    "level0": { "blurDp": 0, "opacity": 1.0, "border": "none" },
    "level1": { "blurDp": 12, "opacity": 0.80, "border": "subtle" },
    "level2": { "blurDp": 16, "opacity": 0.75, "border": "subtle" },
    "level3": { "blurDp": 20, "opacity": 0.82, "border": "rimActive" },
    "level4": { "blurDp": 28, "opacity": 0.90, "border": "rimActive" }
  },
  "typography": {
    "fontFamilies": {
      "primary": "Outfit, Inter, sans-serif",
      "mono": "JetBrains Mono, SF Mono, monospace"
    },
    "sizes": {
      "displayTime": { "fontSize": 16, "lineHeight": 20, "fontWeight": 700, "fontFamily": "mono" },
      "bpmValue": { "fontSize": 14, "lineHeight": 18, "fontWeight": 600, "fontFamily": "mono" },
      "trackTitle": { "fontSize": 12, "lineHeight": 14, "fontWeight": 500, "fontFamily": "primary" },
      "sectionLabel": { "fontSize": 11, "lineHeight": 13, "fontWeight": 600, "fontFamily": "primary" },
      "paramLabel": { "fontSize": 10, "lineHeight": 12, "fontWeight": 400, "fontFamily": "primary" },
      "paramValue": { "fontSize": 9, "lineHeight": 11, "fontWeight": 400, "fontFamily": "mono" },
      "microBadge": { "fontSize": 8, "lineHeight": 10, "fontWeight": 700, "fontFamily": "primary" }
    }
  },
  "spacing": {
    "micro": 2,
    "base": 4,
    "standard": 8,
    "medium": 12,
    "large": 16,
    "xlarge": 24
  },
  "radii": {
    "micro": 2,
    "tile": 4,
    "module": 6,
    "modal": 8,
    "pill": 999
  }
}
